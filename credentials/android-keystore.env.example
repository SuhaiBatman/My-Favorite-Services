# Copy to android-keystore.env (gitignored). Never commit real passwords.
#
# Release keystore (EAS or local signing):
# ANDROID_RELEASE_STORE_FILE=release.keystore
# ANDROID_RELEASE_KEY_ALIAS=your-release-alias
# ANDROID_RELEASE_STORE_PASSWORD=your-store-password
# ANDROID_RELEASE_KEY_PASSWORD=your-key-password
#
# Debug keystore (optional overrides):
# ANDROID_DEBUG_STORE_FILE=debug.keystore
# ANDROID_DEBUG_KEY_ALIAS=androiddebugkey
# ANDROID_DEBUG_STORE_PASSWORD=android
# ANDROID_DEBUG_KEY_PASSWORD=android
