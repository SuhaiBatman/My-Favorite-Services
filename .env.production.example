# Copy to `.env.production` for hosted Supabase (never commit `.env.production`).
# Used by: npm run android:prod, npm run ios:prod, npm run start:prod
#
# Optional: put shared keys (Mapbox, Google, etc.) in `.env` — they merge into both profiles.

EXPO_PUBLIC_SUPABASE_USE_LOCAL=false
EXPO_PUBLIC_SUPABASE_URL=https://oukcgzbjuajoghvnlndx.supabase.co
# Dashboard → Settings → API → Publishable key (sb_publishable_...) or legacy anon JWT
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key

# --- Supabase Auth redirect URLs (Dashboard → Auth → URL Configuration) ---
#   myfavoriteservices://auth/callback
# Google Cloud → OAuth client → Authorized redirect URIs:
#   https://oukcgzbjuajoghvnlndx.supabase.co/auth/v1/callback

# Native Google Sign-In (@react-native-google-signin/google-signin)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-id

# Native Apple Sign-In:
# - Enable Apple in Supabase Auth providers.
# - Add the iOS bundle ID to Apple Client IDs:
#   com.suhaibatman.myfavoriteservices

# RevenueCat (SDK public keys from Project → API keys)
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_...
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_...
# Optional shared fallback:
# EXPO_PUBLIC_REVENUECAT_API_KEY=

# EAS Build: also set EXPO_PUBLIC_* in Expo dashboard (Project → Environment variables).

# RevenueCat secret (server only — never commit real values)
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PROJECT_ID=proj...
