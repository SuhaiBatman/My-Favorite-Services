# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (copy from *.example templates)
.env
.env.local
.env.production
.env*.local

# Supabase CLI link state (project ref, pooler URL — not for git)
supabase/.temp/

# Machine-local LAN IP for local Supabase (`npm run lan:sync` / postinstall)
constants/localSupabaseHost.ts
constants/supabaseEnv.ts

# Android signing secrets (keep *.example templates)
credentials/*
!credentials/*.example

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
