{
  "expo": {
    "name": "My Favorite Services",
    "slug": "my-favorite-services",
    "owner": "my-favorite-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myfavoriteservices",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.suhaibatman.myfavoriteservices",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow My-Favorite-Services to use FaceID for secure access.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.suhaibatman.myfavoriteservices",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "imageWidth": 280,
            "backgroundColor": "#0B1120"
          }
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow My-Favorite-Services to access your camera to scan provider QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aaff63f8-e62d-4e54-8a09-86a192a208af"
      }
    }
  }
}
