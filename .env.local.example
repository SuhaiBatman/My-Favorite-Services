# Copy to `.env.local` for local development (never commit `.env.local`).
# Used by: npm run android:dev, npm run ios:dev, npm start, npm run dev:local
#
# Optional: put shared keys (Mapbox, Google, etc.) in `.env` — they merge into both profiles.

EXPO_PUBLIC_SUPABASE_USE_LOCAL=true
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Demo anon JWT from `supabase start` (always the same locally)
EXPO_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Mac LAN IP: `npm run lan:sync` writes constants/localSupabaseHost.ts (gitignored).
# Test emails: http://127.0.0.1:54324 (Inbucket)

# Address / place autocomplete (optional — shared in `.env` works too)
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token
# EXPO_PUBLIC_LOCATIONIQ_API_KEY=your_locationiq_key

# Native Google Sign-In (optional for local; OAuth redirect must match local Supabase)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.your-ios-id

# Native Apple Sign-In is enabled in supabase/config.toml for iOS development builds.
# The local Supabase Apple provider validates id tokens for bundle ID:
#   com.suhaibatman.myfavoriteservices

# RevenueCat (SDK public keys from Project → API keys)
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_...
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_...
# Optional shared fallback:
# EXPO_PUBLIC_REVENUECAT_API_KEY=test_...

# RevenueCat secret (server only — never commit real values)
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_PROJECT_ID=proj...
