# Mac LAN IP + URL are written to constants/generated/supabase-host.ts
# automatically by `npm start` (polls every 3s when Wi‑Fi changes).
# One-off sync: npm run lan:sync

# Address / place autocomplete (airports, landmarks, streets)
#
# Recommended — Mapbox Search Box (Google-like quality, $0 on free tier):
#   1. https://account.mapbox.com/ → sign up (free)
#   2. Create a public token (starts with pk.)
#   3. Free tier: 100,000 search sessions/month — no charge within that limit
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token
#
# Alternative free tier — LocationIQ (5,000 requests/day):
# EXPO_PUBLIC_LOCATIONIQ_API_KEY=your_locationiq_key
#
# Without either token, search falls back to basic OpenStreetMap (poor for "DFW airport").

# --- Production (cloud) — used by EAS Build and release installs ---
# These are also baked into constants/supabase-cloud.ts as fallbacks when .env
# is unavailable (EAS does not upload gitignored .env).
EXPO_PUBLIC_SUPABASE_USE_LOCAL=false
EXPO_PUBLIC_SUPABASE_URL=https://oukcgzbjuajoghvnlndx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key
