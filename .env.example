# Copy to `.env.local` for local Supabase development (database/API only).
#
# If EXPO_PUBLIC_SUPABASE_URL points to *.supabase.co (in `.env`), the app uses
# hosted Supabase even when USE_LOCAL=true — required for Google OAuth.
# Set EXPO_PUBLIC_SUPABASE_FORCE_LOCAL=true to force local API (OAuth will break).

EXPO_PUBLIC_SUPABASE_USE_LOCAL=true
# Standard local anon key from `supabase start` (only used when API is local)
EXPO_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Mac LAN IP + URL are written to constants/generated/supabase-host.ts
# automatically by `npm start` (polls every 3s when Wi‑Fi changes).
# One-off sync: npm run lan:sync

# Address / place autocomplete (airports, landmarks, streets)
#
# Recommended — Mapbox Search Box (Google-like quality, $0 on free tier):
#   1. https://account.mapbox.com/ → sign up (free)
#   2. Create a public token (starts with pk.)
#   3. Free tier: 100,000 search sessions/month — no charge within that limit
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_public_token
#
# Alternative free tier — LocationIQ (5,000 requests/day):
# EXPO_PUBLIC_LOCATIONIQ_API_KEY=your_locationiq_key
#
# Without either token, search falls back to basic OpenStreetMap (poor for "DFW airport").

# --- Supabase Auth redirect URLs (Dashboard → Auth → URL Configuration) ---
# Add every URL your app uses after OAuth / email confirm / password reset:
#   myfavoriteservices://auth/callback          (dev build / production)
#   exp://127.0.0.1:8081/--/auth/callback       (Expo Go dev)
#   exp://localhost:8081/--/auth/callback
#   exp://YOUR_LAN_IP:8081/--/auth/callback     (Expo Go on device — check Metro log)
# On sign-in, the app logs the exact redirect URI in the console; add that URL if OAuth fails.
# Google Cloud Console → OAuth client → Authorized redirect URIs must include:
#   https://oukcgzbjuajoghvnlndx.supabase.co/auth/v1/callback

# --- Native Google Sign-In (@react-native-google-signin/google-signin) ---
# Requires a dev/production build (npm run android:dev) — does NOT work in Expo Go.
# 1. Google Cloud → create OAuth clients: Web, Android, iOS
# 2. Web client ID → Supabase Dashboard → Auth → Google (Client IDs + enable provider)
# 3. Supabase → Auth → Google → enable "Skip nonce check" (required for native sign-in)
# 4. Android: add SHA-1 from `eas credentials` or `./android` keystore to Google Cloud Android client
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=674563099428-te031jnic99kdf4iel4k92if5m91vaqu.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=674563099428-10bcqnfrk8cvsjcq0mu89dtug89ta219.apps.googleusercontent.com
# Supabase → Auth → Google → Client IDs (comma-separated, both Web + Android):
#   674563099428-te031jnic99kdf4iel4k92if5m91vaqu.apps.googleusercontent.com,674563099428-10bcqnfrk8cvsjcq0mu89dtug89ta219.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-ios.apps.googleusercontent.com
# Optional (auto-derived from iOS client ID if omitted):
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123456789-ios

# --- Production (cloud) — used by EAS Build and release installs ---
# These are also baked into constants/supabase-cloud.ts as fallbacks when .env
# is unavailable (EAS does not upload gitignored .env).
EXPO_PUBLIC_SUPABASE_USE_LOCAL=false
EXPO_PUBLIC_SUPABASE_URL=https://oukcgzbjuajoghvnlndx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key
